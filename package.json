{
  "name": "veles-voyage-next",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build:content": "velite build",
    "build:llm": "tsx scripts/generate-llms-full.ts",
    "build": "npm run build:content && npm run build:llm && next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "prepare": "husky",
    "clean": "rimraf .next",
    "clean-all": "rimraf .next node_modules",
    "fresh": "npm run clean && npm run dev",
    "fresh-install": "npm run clean-all && npm install --legacy-peer-deps && npm run dev",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:api": "jest src/__tests__/api",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "analyze": "cross-env ANALYZE=true npm run build",
    "build:analyze": "npm run build && npx @next/bundle-analyzer",
    "measure": "node scripts/measure-performance.js",
    "check-bundle": "node scripts/check-bundle-size.js",
    "export": "next build && next export",
    "update:cities": "npx tsx scripts/update-cities.ts",
    "update:airports": "npx tsx scripts/update-airports.ts",
    "update:data": "npm run update:cities && npm run update:airports",
    "sync:hotels": "tsx src/workers/sync-hotels.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@heroicons/react": "^2.0.18",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "^8.21.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/uuid": "^10.0.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "argon2": "^0.45.1",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "blurhash": "^2.0.5",
    "critters": "^0.0.25",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.30.6",
    "drizzle-orm": "^0.45.2",
    "encoding": "^0.1.13",
    "fast-xml-parser": "^5.10.1",
    "framer-motion": "^12.43.0",
    "groq-sdk": "^1.4.0",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.27.0",
    "maplibre-gl": "^6.0.0",
    "meilisearch": "^0.60.0",
    "next": "^15.5.22",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-map-gl": "^8.1.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "rimraf": "^6.1.3",
    "uuid": "^14.0.1",
    "velite": "^0.4.0",
    "web-push": "^3.6.7",
    "web-vitals": "^6.0.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.12",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/google.maps": "^3.65.3",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.50.0",
    "autoprefixer": "^10.5.4",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-config-next": "^16.2.12",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "icojs": "^1.0.0",
    "image-size": "^2.0.2",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^17.3.0",
    "playwright": "^1.57.0",
    "postcss": "^8.5.24",
    "postcss-import": "^17.0.0",
    "postcss-nesting": "^14.0.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "to-ico": "^1.1.5",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "lint-staged": {
    "*.{md,mdx}": "velite build",
    "*.{ts,tsx,js,jsx}": "next lint"
  }
}
