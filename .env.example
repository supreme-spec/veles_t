# Конфигурация для разработки
NEXT_PUBLIC_NODE_ENV=development

# URL приложения
NEXT_PUBLIC_APP_URL=http://localhost:3000

# TON Connect настройки
NEXT_PUBLIC_TON_MANIFEST_URL=http://localhost:3000/tonconnect-manifest.json

# Unsplash API для еженедельных фото
NEXT_PUBLIC_UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
UNSPLASH_SECRET_KEY=your_unsplash_secret_key_here
UNSPLASH_APPLICATION_ID=your_unsplash_application_id_here

# SMTP настройки для отправки email (Mailcow)
# Для Mailcow на VPS: mail.veles-voyage.ru, порт 587
SMTP_HOST=mail.veles-voyage.ru
SMTP_PORT=587
SMTP_USER=hello@veles-voyage.ru
SMTP_PASS=your_mailcow_password
CONTACT_EMAIL=hello@veles-voyage.ru

# Настройки отладки
NEXT_PUBLIC_DEBUG=false

# Настройки аналитики (если используется)
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# ========================================
# DATABASE
# ========================================
DATABASE_URL=postgresql://veles:veles_secure_password_2026@localhost:5432/veles_voyage

# ========================================
# REDIS
# ========================================
REDIS_URL=redis://localhost:6379

# ========================================
# MEILISEARCH
# ========================================
MEILISEARCH_URL=http://localhost:7700
MEILI_MASTER_KEY=veles_meilisearch_master_key_2026
NEXT_PUBLIC_MEILISEARCH_URL=http://localhost:7700

# ========================================
# OSTROVOK API (Affiliate + NOW)
# ========================================
OSTROVOK_API_KEY=your_ostrovok_api_key_here
OSTROVOK_D_KEY=your_ostrovok_d_key_here
OSTROVOK_IS_TEST=true
OSTROVOK_TEST_HID=8526976

# ========================================
# ALEAN (туроператор)
# ========================================
ALEAN_ENDPOINT=https://ksb3.alean.ru/webservice/ewebsvc.dll/soap/
ALEAN_LOGIN=your_alean_login_here
ALEAN_PASSWORD=your_alean_password_here

# ========================================
# PAYMENT & BOOKING
# ========================================
RETURN_PATH_URL=https://veles-voyage.ru/api/booking/3ds-callback

# ========================================
# Cloudflare R2 (media storage)
# ========================================
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=veles-hotels
R2_PUBLIC_URL=https://your-r2-public-url.r2.dev

# ========================================
# REVALIDATION
# ========================================
REVALIDATION_TOKEN=veles_revalidation_token_2026

# ========================================
# DOCKER PASSWORDS
# ========================================
POSTGRES_PASSWORD=veles_secure_password_2026
